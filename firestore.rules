rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cycles/{cycleId} {
      allow read, write: if true;
    }
    match /measurements/{measurementId} {
      allow read, write: if true;
    }
    match /notes/{noteId} {
      allow read, write: if true;
    }
    match /userProfile/{profileId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
